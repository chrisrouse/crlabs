{
  "name": "crlabs",
  "private": true,
  "version": "0.1.0",
  "description": "crlabs Salesforce packages",
  "scripts": {
    "lint": "eslint foundations/force-app/components/**/lwc/**/*.js foundations/test/**/lwc/**/*.js screen-flow/screen-timer/**/lwc/**/*.js screen-flow/email-recipients/**/lwc/**/*.js screen-flow/flow-grid/**/lwc/**/*.js",
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "prettier": "prettier --write \"{foundations/force-app/components,foundations/test,screen-flow/screen-timer,screen-flow/email-recipients}/**/*.{js,html,css,json,md}\" \"screen-flow/flow-grid/**/*.{js,html,css,json}\"",
    "prettier:verify": "prettier --check \"{foundations/force-app/components,foundations/test,screen-flow/screen-timer,screen-flow/email-recipients}/**/*.{js,html,css,json,md}\" \"screen-flow/flow-grid/**/*.{js,html,css,json}\" \"foundations/force-app/flow-config-editor-kit/**/*.{js,html,css,json,cls}\"",
    "verify": "npm run prettier:verify && npm run lint && npm run test:unit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@lwc/eslint-plugin-lwc": "^3.5.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@salesforce/eslint-config-lwc": "^4.1.2",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "prettier": "^3.9.6",
    "prettier-plugin-apex": "^2.3.0"
  }
}
