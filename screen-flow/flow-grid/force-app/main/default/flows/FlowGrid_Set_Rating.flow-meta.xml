<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description
    >Example AUTOLAUNCHED flow launched by Flow Grid's Flow row action, and the twin of FlowGrid_Edit_Account: same variable contract, no screens. Flow Grid invokes it server-side through Flow.Interview and folds `record` back into the grid, so the user sees no modal at all — just a brief running indicator and then the updated row. Deliberately does no DML, which also makes it safe for an Apex test to invoke.</description>
    <environments>Default</environments>
    <interviewLabel>Flow Grid Set Rating {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Flow Grid Set Rating (Autolaunched)</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <!-- Same contract as the screen-flow example, so one row action can be pointed
         at either and the launch mode is the only difference. -->
    <variables>
        <name>record</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Rating</targetReference>
        </connector>
    </start>

    <assignments>
        <name>Set_Rating</name>
        <label>Set Rating</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignmentItems>
            <assignToReference>record.Rating</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Hot</stringValue>
            </value>
        </assignmentItems>
    </assignments>
</Flow>
