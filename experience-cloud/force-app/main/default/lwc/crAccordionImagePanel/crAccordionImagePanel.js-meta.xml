<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Accordion Image Panel</masterLabel>
    <description>Shows the image for the open section of a linked accordion, or a default image while none is open.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="linkedAccordion" type="String" label="Linked Accordion" default="" description="The Link Name of the accordion this panel follows." />
            <property name="versionInfo" type="String" label="Version" default="" editor="c/crVersionInfo" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
