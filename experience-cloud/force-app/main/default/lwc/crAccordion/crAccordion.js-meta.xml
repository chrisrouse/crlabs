<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Accordion</masterLabel>
    <description>Vertically stacked sections. Opening one section closes the others unless multiple sections are allowed.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="allowMultipleSectionsOpen" type="Boolean" label="Allow Multiple Sections Open" default="false" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
