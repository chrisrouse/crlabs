<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Accordion</masterLabel>
    <description>Vertically stacked sections. Opening one section closes the others unless multiple sections are allowed.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="allowMultipleSectionsOpen" type="Boolean" label="Allow Multiple Sections Open" default="false" />
            <property name="showActions" type="Boolean" label="Show Actions" default="true" />
            <property name="linkName" type="String" label="Link Name" default="" description="Links this accordion to an Accordion Image Panel. Enter the same name in the panel's Linked Accordion." />
            <property name="appearance" type="String" label="Appearance" default="" editor="c/crAccordionAppearanceEditor" />
            <property name="versionInfo" type="String" label="Version" default="" editor="c/crVersionInfo" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
